# Normalize text to LF in the repo; check out LF on Windows too (avoid CRLF churn).
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.duckdb binary
*.pkl binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
